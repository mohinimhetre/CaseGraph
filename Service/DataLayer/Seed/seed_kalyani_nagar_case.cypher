// MATCH path = (r:Person {name: 'Raj Kumar'})-[*1..3]-(s:Person {name: 'Shalini Mane'}) RETURN [n IN nodes(path) | coalesce(n.name, n.id)] AS hops, length(path) AS depth ORDER BY depth ASC LIMIT 3
