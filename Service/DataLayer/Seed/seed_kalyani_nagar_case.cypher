// STEP 0: Clear
MATCH (n) DETACH DELETE n

// STEP 1: Organizations
CREATE (:Organization {id: 'org_001', name: 'Shivajinagar Police Station', type: 'police_station', district: 'Pune'})

// STEP 2: Investigator + link to station
CREATE (:Investigator {id: 'inv_001', name: 'SI Priya Sharma', rank: 'Sub Inspector', badgeNumber: 'MH-PN-SI-4421'}) WITH 1 AS dummy MATCH (i:Investigator {id: 'inv_001'}), (o:Organization {id: 'org_001'}) CREATE (i)-[:MEMBER_OF]->(o)

// STEP 3: Case + assign investigator + link org
CREATE (:Case {id: 'case_001', name: 'Kalyani Nagar Murder', type: 'homicide', status: 'open', dateOpened: '2026-10-10', fir: 'FIR-2026-SHV-0401', jurisdiction: 'Shivajinagar', summary: 'Amit Shah found dead in his flat. Cause of death poisoning. Co-manager Shalini Mane who also fired the suspect is now missing.'}) WITH 1 AS dummy MATCH (i:Investigator {id: 'inv_001'}), (c:Case {id: 'case_001'}) CREATE (i)-[:ASSIGNED_TO {role: 'lead_investigator', since: '2026-10-10'}]->(c) WITH 1 AS dummy MATCH (o:Organization {id: 'org_001'}), (c:Case {id: 'case_001'}) CREATE (o)-[:HANDLES]->(c)

// STEP 4: Persons
CREATE (:Person {id: 'per_001', name: 'Amit Shah', dob: '1986-04-10', gender: 'male', address: 'Flat 6C Kalyani Nagar Pune', occupation: 'Software Manager', role: 'victim', phones: ['+91-9810-111-222']})

CREATE (:Person {id: 'per_002', name: 'Shalini Mane', dob: '1988-08-25', gender: 'female', address: 'Viman Nagar Pune', occupation: 'Software Manager', role: 'missing', phones: ['+91-9822-333-444'], notes: 'Co-manager with Amit. Jointly fired Raj. Left for Mahabaleshwar two days before murder. Unreachable. Listed missing.'})

CREATE (:Person {id: 'per_003', name: 'Raj Kumar', dob: '1990-12-03', gender: 'male', address: 'Hadapsar Pune', occupation: 'Unemployed formerly Software Developer', role: 'suspect', phones: ['+91-9833-555-666'], notes: 'Fired jointly by Amit and Shalini. Publicly threatened both on LinkedIn after termination.'})

CREATE (:Person {id: 'per_004', name: 'Riya Desai', dob: '1992-06-17', gender: 'female', address: 'Koregaon Park Pune', occupation: 'Software Developer', role: 'witness', phones: ['+91-9844-777-888']})

CREATE (:Person {id: 'per_005', name: 'Mohan Shinde', dob: '1970-02-28', gender: 'male', address: 'Wadgaon Sheri Pune', occupation: 'Security Guard', role: 'witness', phones: ['+91-9855-999-000']})

// STEP 5: Person to case links
 WITH 1 AS dummy MATCH (p:Person {id: 'per_001'}), (c:Case {id: 'case_001'}) CREATE (p)-[:VICTIM_IN]->(c) WITH 1 AS dummy MATCH (p:Person {id: 'per_002'}), (c:Case {id: 'case_001'}) CREATE (p)-[:MISSING_IN]->(c) WITH 1 AS dummy MATCH (p:Person {id: 'per_003'}), (c:Case {id: 'case_001'}) CREATE (p)-[:SUSPECT_IN]->(c) WITH 1 AS dummy MATCH (p:Person {id: 'per_004'}), (c:Case {id: 'case_001'}) CREATE (p)-[:WITNESS_IN]->(c) WITH 1 AS dummy MATCH (p:Person {id: 'per_005'}), (c:Case {id: 'case_001'}) CREATE (p)-[:WITNESS_IN]->(c)

// STEP 6: Person to person relationships
WITH 1 AS dummy MATCH (a:Person {id: 'per_001'}), (s:Person {id: 'per_002'}) CREATE (a)-[:WORKS_WITH {role: 'co_manager'}]->(s) WITH 1 AS dummy MATCH (a:Person {id: 'per_001'}), (r:Person {id: 'per_003'}) CREATE (a)-[:FIRED {at: '2026-09-20', notes: 'Jointly fired Raj for poor performance'}]->(r) WITH 1 AS dummy MATCH (s:Person {id: 'per_002'}), (r:Person {id: 'per_003'}) CREATE (s)-[:FIRED {at: '2026-09-20', notes: 'Jointly fired Raj for poor performance'}]->(r) WITH 1 AS dummy MATCH (r:Person {id: 'per_003'}), (a:Person {id: 'per_001'}) CREATE (r)-[:THREATENED {at: '2026-09-21', medium: 'LinkedIn', notes: 'Public LinkedIn post threatening both managers'}]->(a) WITH 1 AS dummy MATCH (r:Person {id: 'per_003'}), (s:Person {id: 'per_002'}) CREATE (r)-[:THREATENED {at: '2026-09-21', medium: 'LinkedIn', notes: 'Same LinkedIn post threatened both Amit and Shalini'}]->(s) WITH 1 AS dummy MATCH (r:Person {id: 'per_003'}), (a:Person {id: 'per_001'}) CREATE (r)-[:CONFRONTED {at: '2026-10-03T18:30:00', location: 'Office car park', notes: 'Raj confronted Amit aggressively. Witnessed by Riya Desai.'}]->(a)

// STEP 7: Locations
CREATE (:Location {id: 'loc_001', name: 'Amit Shah Flat Kalyani Nagar', type: 'crime_scene', address: 'Flat 6C Kalyani Nagar Pune 411006'}) WITH 1 AS dummy CREATE (:Location {id: 'loc_002', name: 'Mahabaleshwar', type: 'last_known_location', address: 'Mahabaleshwar Satara District Maharashtra', notes: 'Shalini told her husband she was going here. Unreachable since.'})

// STEP 8: Location links
 WITH 1 AS dummy MATCH (l:Location {id: 'loc_001'}), (c:Case {id: 'case_001'}) CREATE (l)-[:SCENE_OF]->(c) WITH 1 AS dummy MATCH (p:Person {id: 'per_001'}), (l:Location {id: 'loc_001'}) CREATE (p)-[:RESIDES_AT]->(l) WITH 1 AS dummy MATCH (p:Person {id: 'per_002'}), (l:Location {id: 'loc_002'}) CREATE (p)-[:LAST_SEEN_AT {at: '2026-10-08', notes: 'Left for solo trip. Husband dropped her at Pune station.'}]->(l) WITH 1 AS dummy MATCH (p:Person {id: 'per_003'}), (l:Location {id: 'loc_001'}) CREATE (p)-[:SEEN_AT {at: '2026-10-10T19:00:00', source: 'Security guard Mohan Shinde', status: 'confirmed'}]->(l)

// STEP 9: Events
CREATE (:Event {id: 'evt_001', name: 'Raj Kumar Fired', timestamp: '2026-09-20T11:00:00', description: 'Raj Kumar fired jointly by Amit Shah and Shalini Mane for poor performance.'}) WITH 1 AS dummy CREATE (:Event {id: 'evt_002', name: 'LinkedIn Threat by Raj', timestamp: '2026-09-21T09:00:00', description: 'Raj Kumar posted public LinkedIn threat saying both Amit and Shalini would regret their decision.'}) WITH 1 AS dummy CREATE (:Event {id: 'evt_003', name: 'Car Park Confrontation', timestamp: '2026-10-03T18:30:00', description: 'Raj confronted Amit aggressively in office car park. Riya Desai witnessed the incident.'}) WITH 1 AS dummy CREATE (:Event {id: 'evt_004', name: 'Shalini Leaves for Mahabaleshwar', timestamp: '2026-10-08T08:00:00', description: 'Shalini Mane left for solo trip to Mahabaleshwar. Last known contact.'}) WITH 1 AS dummy CREATE (:Event {id: 'evt_005', name: 'Raj Seen Entering Building', timestamp: '2026-10-10T19:00:00', description: 'Security guard Mohan Shinde saw Raj Kumar entering Amits building at 7 PM. Raj denies this.'}) WITH 1 AS dummy CREATE (:Event {id: 'evt_006', name: 'Murder of Amit Shah', timestamp: '2026-10-10T20:00:00', description: 'Estimated time of death. Amit Shah poisoned. Poisoned coffee cup found on his desk.'}) WITH 1 AS dummy CREATE (:Event {id: 'evt_007', name: 'Body Discovered', timestamp: '2026-10-11T08:00:00', description: 'Amits body discovered by building housekeeping staff during morning rounds.'}) WITH 1 AS dummy CREATE (:Event {id: 'evt_gap', name: 'UNACCOUNTED WINDOW 19:00-20:00', timestamp: '2026-10-10T19:00:00', description: 'GAP: Raj seen entering building at 7 PM. Death estimated at 8 PM. One hour window unaccounted inside the flat.'})

// STEP 10: Event to case links
 WITH 1 AS dummy MATCH (e:Event {id: 'evt_001'}), (c:Case {id: 'case_001'}) CREATE (e)-[:PART_OF]->(c) WITH 1 AS dummy MATCH (e:Event {id: 'evt_002'}), (c:Case {id: 'case_001'}) CREATE (e)-[:PART_OF]->(c) WITH 1 AS dummy MATCH (e:Event {id: 'evt_003'}), (c:Case {id: 'case_001'}) CREATE (e)-[:PART_OF]->(c) WITH 1 AS dummy MATCH (e:Event {id: 'evt_004'}), (c:Case {id: 'case_001'}) CREATE (e)-[:PART_OF]->(c) WITH 1 AS dummy MATCH (e:Event {id: 'evt_005'}), (c:Case {id: 'case_001'}) CREATE (e)-[:PART_OF]->(c) WITH 1 AS dummy MATCH (e:Event {id: 'evt_006'}), (c:Case {id: 'case_001'}) CREATE (e)-[:PART_OF]->(c) WITH 1 AS dummy MATCH (e:Event {id: 'evt_007'}), (c:Case {id: 'case_001'}) CREATE (e)-[:PART_OF]->(c) WITH 1 AS dummy MATCH (e:Event {id: 'evt_gap'}), (c:Case {id: 'case_001'}) CREATE (e)-[:PART_OF]->(c)

// STEP 11: Event to person and location links
WITH 1 AS dummy MATCH (e:Event {id: 'evt_001'}), (p:Person {id: 'per_003'}) CREATE (e)-[:INVOLVES {role: 'fired'}]->(p) WITH 1 AS dummy MATCH (e:Event {id: 'evt_001'}), (p:Person {id: 'per_001'}) CREATE (e)-[:INVOLVES {role: 'fired_by'}]->(p) WITH 1 AS dummy MATCH (e:Event {id: 'evt_001'}), (p:Person {id: 'per_002'}) CREATE (e)-[:INVOLVES {role: 'fired_by'}]->(p) WITH 1 AS dummy MATCH (e:Event {id: 'evt_002'}), (p:Person {id: 'per_003'}) CREATE (e)-[:INVOLVES {role: 'posted_threat'}]->(p) WITH 1 AS dummy MATCH (e:Event {id: 'evt_003'}), (p:Person {id: 'per_003'}) CREATE (e)-[:INVOLVES {role: 'aggressor'}]->(p) WITH 1 AS dummy MATCH (e:Event {id: 'evt_003'}), (p:Person {id: 'per_001'}) CREATE (e)-[:INVOLVES {role: 'confronted'}]->(p) WITH 1 AS dummy MATCH (e:Event {id: 'evt_003'}), (p:Person {id: 'per_004'}) CREATE (e)-[:WITNESSED_BY]->(p) WITH 1 AS dummy MATCH (e:Event {id: 'evt_004'}), (p:Person {id: 'per_002'}) CREATE (e)-[:INVOLVES {role: 'departed'}]->(p) WITH 1 AS dummy MATCH (e:Event {id: 'evt_005'}), (p:Person {id: 'per_003'}) CREATE (e)-[:INVOLVES {role: 'seen_entering'}]->(p) WITH 1 AS dummy MATCH (e:Event {id: 'evt_005'}), (p:Person {id: 'per_005'}) CREATE (e)-[:WITNESSED_BY]->(p) WITH 1 AS dummy MATCH (e:Event {id: 'evt_006'}), (p:Person {id: 'per_001'}) CREATE (e)-[:VICTIM_OF]->(p) WITH 1 AS dummy MATCH (e:Event {id: 'evt_005'}), (l:Location {id: 'loc_001'}) CREATE (e)-[:OCCURRED_AT]->(l) WITH 1 AS dummy MATCH (e:Event {id: 'evt_006'}), (l:Location {id: 'loc_001'}) CREATE (e)-[:OCCURRED_AT]->(l) WITH 1 AS dummy MATCH (e:Event {id: 'evt_gap'}), (l:Location {id: 'loc_001'}) CREATE (e)-[:REFERS_TO]->(l)

// STEP 12: Statements
CREATE (:Statement {id: 'stm_001', name: 'Riya Desai Statement', text: 'Raj Kumar had become very aggressive after being fired. He confronted Amit in the car park on 3rd October and was shouting. Amit looked shaken. Raj said they would both pay for what they did to him meaning Amit and Shalini.'}) WITH 1 AS dummy CREATE (:Statement {id: 'stm_002', name: 'Raj Kumar Denial', text: 'I was never at Amits building on 10th October. The guard is lying or confused. I was at home alone that evening. I had no reason to go there.'}) WITH 1 AS dummy CREATE (:Statement {id: 'stm_003', name: 'Mohan Shinde Sighting', text: 'I clearly saw Raj Kumar entering the building at 7 PM on 10th October. I know his face because he had visited Amit sir before. He did not sign the visitor register and walked in quickly.'})

// STEP 13: Statement links and contradiction
 WITH 1 AS dummy MATCH (p:Person {id: 'per_004'}), (s:Statement {id: 'stm_001'}) CREATE (p)-[:GAVE]->(s) WITH 1 AS dummy MATCH (p:Person {id: 'per_003'}), (s:Statement {id: 'stm_002'}) CREATE (p)-[:GAVE]->(s) WITH 1 AS dummy MATCH (p:Person {id: 'per_005'}), (s:Statement {id: 'stm_003'}) CREATE (p)-[:GAVE]->(s) WITH 1 AS dummy MATCH (s:Statement {id: 'stm_001'}), (c:Case {id: 'case_001'}) CREATE (s)-[:RECORDED_IN]->(c) WITH 1 AS dummy MATCH (s:Statement {id: 'stm_002'}), (c:Case {id: 'case_001'}) CREATE (s)-[:RECORDED_IN]->(c) WITH 1 AS dummy MATCH (s:Statement {id: 'stm_003'}), (c:Case {id: 'case_001'}) CREATE (s)-[:RECORDED_IN]->(c) WITH 1 AS dummy MATCH (s1:Statement {id: 'stm_002'}), (s2:Statement {id: 'stm_003'}) CREATE (s1)-[:CONTRADICTS {reason: 'Raj denies being at the building but Mohan clearly identifies him entering at 7 PM'}]->(s2)

// STEP 14: Evidence
CREATE (:Evidence {id: 'evi_001', name: 'Poisoned Coffee Cup', type: 'physical', description: 'Coffee cup found on Amits desk. Lab confirmed traces of potassium cyanide. Partial fingerprints under analysis.', status: 'at_lab', labRefNo: 'PFSL-2026-2201'}) WITH 1 AS dummy CREATE (:Evidence {id: 'evi_002', name: 'LinkedIn Threat Screenshot', type: 'digital', description: 'Screenshot of Raj Kumars LinkedIn post dated 21st September threatening both Amit Shah and Shalini Mane.', status: 'collected'}) WITH 1 AS dummy CREATE (:Evidence {id: 'evi_003', name: 'Building Visitor Log', type: 'documentary', description: 'Visitor log for Amits building on 10th October. Raj did not sign in but guard confirms he entered without registering.', status: 'collected'})

// STEP 15: Evidence links
 WITH 1 AS dummy MATCH (e:Evidence {id: 'evi_001'}), (c:Case {id: 'case_001'}) CREATE (e)-[:COLLECTED_IN]->(c) WITH 1 AS dummy MATCH (e:Evidence {id: 'evi_002'}), (c:Case {id: 'case_001'}) CREATE (e)-[:COLLECTED_IN]->(c) WITH 1 AS dummy MATCH (e:Evidence {id: 'evi_003'}), (c:Case {id: 'case_001'}) CREATE (e)-[:COLLECTED_IN]->(c) WITH 1 AS dummy MATCH (e:Evidence {id: 'evi_001'}), (l:Location {id: 'loc_001'}) CREATE (e)-[:FOUND_AT]->(l)

// STEP 16: Leads
CREATE (:Lead {id: 'led_001', name: 'Locate Shalini Mane', description: 'Shalini missing since 8th October. Contact Mahabaleshwar hotels and local police. Check if she boarded the train.', priority: 'high', status: 'open'}) WITH 1 AS dummy CREATE (:Lead {id: 'led_002', name: 'Fingerprint Analysis Coffee Cup', description: 'Get fingerprint results from PFSL for coffee cup evi_001. Match against Raj Kumars prints.', priority: 'high', status: 'open'}) WITH 1 AS dummy CREATE (:Lead {id: 'led_003', name: 'Trace Poison Source', description: 'Identify source of potassium cyanide. Check if Raj has access to chemicals through prior work.', priority: 'high', status: 'open'}) WITH 1 AS dummy CREATE (:Lead {id: 'led_004', name: 'Verify Raj Alibi', description: 'Raj claims home alone on 10th October evening. Check CCTV near Hadapsar address and phone location data.', priority: 'medium', status: 'open'})

// STEP 17: Lead links
 WITH 1 AS dummy MATCH (l:Lead {id: 'led_001'}), (c:Case {id: 'case_001'}) CREATE (l)-[:PART_OF]->(c) WITH 1 AS dummy MATCH (l:Lead {id: 'led_002'}), (c:Case {id: 'case_001'}) CREATE (l)-[:PART_OF]->(c) WITH 1 AS dummy MATCH (l:Lead {id: 'led_003'}), (c:Case {id: 'case_001'}) CREATE (l)-[:PART_OF]->(c) WITH 1 AS dummy MATCH (l:Lead {id: 'led_004'}), (c:Case {id: 'case_001'}) CREATE (l)-[:PART_OF]->(c) WITH 1 AS dummy MATCH (l:Lead {id: 'led_001'}), (o:Organization {id: 'org_001'}) CREATE (l)-[:ASSIGNED_TO]->(o) WITH 1 AS dummy MATCH (l:Lead {id: 'led_002'}), (o:Organization {id: 'org_001'}) CREATE (l)-[:ASSIGNED_TO]->(o) WITH 1 AS dummy MATCH (l:Lead {id: 'led_003'}), (o:Organization {id: 'org_001'}) CREATE (l)-[:ASSIGNED_TO]->(o) WITH 1 AS dummy MATCH (l:Lead {id: 'led_004'}), (o:Organization {id: 'org_001'}) CREATE (l)-[:ASSIGNED_TO]->(o)

// STEP 18: Hypothesis + links
CREATE (:Hypothesis {id: 'hyp_001', name: 'Raj Kumar Revenge Theory', text: 'Raj Kumar entered Amits flat on the evening of 10th October poisoned his coffee in revenge for being fired and left before the poison took effect. Shalini Mane may be his next target.', confidence: 0.70, createdAt: '2026-10-11T10:00:00', status: 'active'}) WITH 1 AS dummy MATCH (h:Hypothesis {id: 'hyp_001'}), (c:Case {id: 'case_001'}) CREATE (h)-[:ABOUT]->(c) WITH 1 AS dummy MATCH (h:Hypothesis {id: 'hyp_001'}), (e:Evidence {id: 'evi_002'}) CREATE (h)-[:SUPPORTED_BY {note: 'LinkedIn threat names both Amit and Shalini as targets'}]->(e) WITH 1 AS dummy MATCH (h:Hypothesis {id: 'hyp_001'}), (e:Evidence {id: 'evi_003'}) CREATE (h)-[:SUPPORTED_BY {note: 'Raj entered building without signing visitor log'}]->(e) WITH 1 AS dummy MATCH (h:Hypothesis {id: 'hyp_001'}), (s:Statement {id: 'stm_002'}) CREATE (h)-[:CONTRADICTED_BY {note: 'Raj denies being at the building'}]->(s)

// STEP 19: Traits
CREATE (:Trait {id: 'trt_001', name: 'Weapon: Poison', category: 'weapon', value: 'poison'}) WITH 1 AS dummy CREATE (:Trait {id: 'trt_002', name: 'Victim: Male Professional', category: 'victim_profile', value: 'male_professional'}) WITH 1 AS dummy CREATE (:Trait {id: 'trt_003', name: 'Motive: Workplace Revenge', category: 'motive_type', value: 'workplace_revenge'}) WITH 1 AS dummy CREATE (:Trait {id: 'trt_004', name: 'Location: Residential', category: 'location_type', value: 'residential'})

// STEP 20: Trait links
 WITH 1 AS dummy MATCH (c:Case {id: 'case_001'}), (t:Trait {id: 'trt_001'}) CREATE (c)-[:HAS_TRAIT]->(t) WITH 1 AS dummy MATCH (c:Case {id: 'case_001'}), (t:Trait {id: 'trt_002'}) CREATE (c)-[:HAS_TRAIT]->(t) WITH 1 AS dummy MATCH (c:Case {id: 'case_001'}), (t:Trait {id: 'trt_003'}) CREATE (c)-[:HAS_TRAIT]->(t) WITH 1 AS dummy MATCH (c:Case {id: 'case_001'}), (t:Trait {id: 'trt_004'}) CREATE (c)-[:HAS_TRAIT]->(t)

// STEP 21: Verify - run these one at a time
